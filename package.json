{
  "name": "tranquil-automations",
  "main": "./lib/tranquil-automations",
  "version": "0.1.1",
  "description": "Write and run sandboxed TypeScript automations against any web app",
  "keywords": [],
  "repository": "https://github.com/tranquillabs/tranquil-automations",
  "author": {
    "name": "Tranquil Labs",
